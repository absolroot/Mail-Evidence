<Application x:Class="MailViewer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:local="clr-namespace:MailViewer.App" xmlns:desk="clr-namespace:JournalDesk"
             ThemeMode="Light">
    <Application.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="WorkspaceChrome.xaml"/><ResourceDictionary Source="LucideIcons.xaml"/><ResourceDictionary Source="TableHeader.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <ControlTemplate x:Key="CommandIcon" TargetType="ContentControl">
            <ContentPresenter Content="{TemplateBinding Content}">
                <ContentPresenter.Resources>
                    <DataTemplate DataType="{x:Type Geometry}">
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24" ClipToBounds="True">
                                <Path Data="{Binding}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <Trigger Property="local:MainWindow.FillCommandIcon" Value="True">
                                                    <Setter Property="Fill" Value="{Binding Stroke, RelativeSource={RelativeSource Self}}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Canvas>
                        </Viewbox>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type sys:String}">
                        <TextBlock Text="{Binding}" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                    </DataTemplate>
                </ContentPresenter.Resources>
            </ContentPresenter>
        </ControlTemplate>
        <Thickness x:Key="EvidencePaneInset">8,4,8,6</Thickness>
        <Style x:Key="EvidenceToolbar" TargetType="DockPanel">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <sys:Double x:Key="WorkspaceRailHeight">36</sys:Double>
        <Style x:Key="PaneHeading" TargetType="Border">
            <Setter Property="Height" Value="{StaticResource WorkspaceRailHeight}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Background" Value="{DynamicResource Viewer.Canvas}"/>
        </Style>
        <Style x:Key="MailboxWorkspacePane" TargetType="Border" BasedOn="{StaticResource Desk.WorkspacePane}">
            <Setter Property="Background" Value="{DynamicResource Viewer.Canvas}"/>
            <Setter Property="BorderThickness" Value="1,0,1,1"/>
            <Setter Property="CornerRadius" Value="0,0,7,7"/>
        </Style>
        <Style x:Key="MailboxWorkspaceTab" TargetType="TabItem" BasedOn="{StaticResource Desk.WorkspaceTab}">
            <Setter Property="Background" Value="{DynamicResource Viewer.Canvas}"/>
        </Style>
        <Style x:Key="WorkspaceTabs" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource MailboxWorkspaceTab}"/>
            <Setter Property="Background" Value="{DynamicResource Viewer.Canvas}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel KeyboardNavigation.TabNavigation="Local">
                            <Grid DockPanel.Dock="Top">
                                <Border Background="{DynamicResource Viewer.TabRail}" BorderBrush="{DynamicResource Viewer.TabRule}"
                                        BorderThickness="0,0,0,1" CornerRadius="5,5,0,0" SnapsToDevicePixels="True"/>
                                <DockPanel IsItemsHost="True" LastChildFill="False" KeyboardNavigation.TabNavigation="Once"/>
                            </Grid>
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="EvidenceVisibility"/>
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Desk.KeyboardOutline}"/>
            <Setter Property="Background" Value="{DynamicResource Viewer.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Viewer.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Viewer.Rule}"/>
        </Style>
        <Style x:Key="ViewerComboBox" TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Desk.KeyboardOutline}"/>
            <Setter Property="Template" Value="{DynamicResource DefaultComboBoxTemplate}"/>
            <Setter Property="Background" Value="{DynamicResource Viewer.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Viewer.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Viewer.Rule}"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ViewerComboBox}"/>
        <Style TargetType="Expander">
            <Setter Property="Background" Value="{DynamicResource Viewer.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Viewer.Text}"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Desk.KeyboardOutline}"/>
            <Setter Property="Background" Value="{DynamicResource Viewer.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Viewer.Text}"/>
            <Setter Property="SelectedDateFormat" Value="Short"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Desk.KeyboardOutline}"/>
            <Setter Property="Background" Value="{DynamicResource Viewer.Canvas}"/>
            <Setter Property="Foreground" Value="{DynamicResource Viewer.Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Viewer.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Viewer.Rule}"/>
        </Style>
        <DataTemplate x:Key="FormActionCaption">
            <StackPanel Orientation="Horizontal">
                <ContentControl x:Name="FormGlyph" Content="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                Template="{StaticResource CommandIcon}" Margin="0,0,6,0" VerticalAlignment="Center"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Focusable="False" IsTabStop="False"/>
                <TextBlock Text="{Binding}" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <Trigger SourceName="FormGlyph" Property="Content" Value="{x:Null}">
                    <Setter TargetName="FormGlyph" Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="FormAction" TargetType="Button" BasedOn="{StaticResource Desk.FormButton}">
            <Setter Property="ContentTemplate" Value="{StaticResource FormActionCaption}"/>
        </Style>
        <Style x:Key="PrimaryFormAction" TargetType="Button" BasedOn="{StaticResource Desk.FormPrimary}">
            <Setter Property="ContentTemplate" Value="{StaticResource FormActionCaption}"/>
        </Style>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="27"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <Grid>
                                <Border x:Name="HoverLayer" Background="{DynamicResource Viewer.Hover}"
                                        CornerRadius="2" Opacity="0" IsHitTestVisible="False"/>
                                <Border x:Name="PressLayer" Background="{DynamicResource Viewer.Pressed}"
                                        CornerRadius="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <DockPanel HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}">
                                <ContentControl x:Name="Glyph" DockPanel.Dock="Left" Content="{TemplateBinding Tag}" Template="{StaticResource CommandIcon}"
                                                Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"
                                                IsTabStop="False" Focusable="False" Margin="0,0,6,0"/>
                                <ContentPresenter x:Name="Label" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/>
                            </DockPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="ContentStringFormat" Value="GlyphOnly">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Glyph" Property="Margin" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsDefaulted" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Viewer.Accent}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="HoverLayer" Property="local:InteractionFeedback.HoverVisible" Value="True"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PressLayer" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Viewer.Canvas}"/>
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Viewer.Rule}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Viewer.Disabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietAction" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
        <Style x:Key="IconAction" TargetType="Button" BasedOn="{StaticResource QuietAction}">
            <Setter Property="ContentStringFormat" Value="GlyphOnly"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="27"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="{DynamicResource Viewer.Selection}"/>
            <Setter Property="Foreground" Value="{DynamicResource Viewer.SelectionText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Viewer.Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Copyable" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style x:Key="CopyField" TargetType="desk:CopyText" BasedOn="{StaticResource Copyable}">
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="desk:CopyText">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                            <Button x:Name="PART_Copy" Grid.Column="1" Style="{StaticResource IconAction}"
                                    Width="22" Height="19" MinHeight="0" Visibility="Hidden"
                                    Tag="{Binding Content, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Copy" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PART_Copy" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PART_Copy" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Viewer.SelectionText}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="MailFieldValueCell">
            <desk:CopyText Style="{StaticResource CopyField}" Text="{Binding Value, Mode=OneWay}"
                           Padding="2,0" TextWrapping="NoWrap" FocusVisualStyle="{StaticResource Desk.KeyboardOutline}"
                           VerticalScrollBarVisibility="Disabled" ToolTip="{Binding Value}"
                           ContextMenu="{Binding ContextMenu, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                           AutomationProperties.AutomationId="MailFieldValue"/>
        </DataTemplate>
        <Style x:Key="ReaderCopyField" TargetType="desk:CopyText" BasedOn="{StaticResource CopyField}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="BodyFormatButton" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="27"/>
            <Setter Property="MinWidth" Value="54"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Foreground" Value="{DynamicResource Viewer.Muted}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Desk.KeyboardOutline}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment" Background="{DynamicResource Viewer.Panel}" CornerRadius="2">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource Viewer.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource Viewer.Selection}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Viewer.SelectionText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="desk:CopyText" BasedOn="{StaticResource CopyField}"/>
        <Style x:Key="EvidenceCellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True"/>
        </Style>
        <Style x:Key="EvidenceNumber" TargetType="TextBlock" BasedOn="{StaticResource EvidenceCellText}">
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="EvidenceTab" TargetType="TabItem" BasedOn="{StaticResource Desk.SecondaryTab}">
            <Setter Property="MinHeight" Value="{StaticResource WorkspaceRailHeight}"/>
        </Style>
        <Style x:Key="EvidenceTabs" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource EvidenceTab}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="{DynamicResource Viewer.Canvas}" BorderBrush="{DynamicResource Viewer.TabRule}"
                                    BorderThickness="0,0,0,1" SnapsToDevicePixels="True"/>
                            <WrapPanel x:Name="EvidenceTabRail" IsItemsHost="True" Margin="6,0,6,0" KeyboardNavigation.TabIndex="1" KeyboardNavigation.TabNavigation="Once"/>
                            <ContentPresenter Grid.Row="1" Content="{TemplateBinding Tag}"/>
                            <ContentPresenter Grid.Row="2" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VerticalPaneSplitter" TargetType="GridSplitter">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="ResizeDirection" Value="Columns"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Desk.KeyboardOutline}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{DynamicResource Viewer.Inset}">
                            <Border x:Name="Rule" Width="1" HorizontalAlignment="Center" Background="{DynamicResource Viewer.Muted}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rule" Property="Width" Value="3"/>
                                <Setter TargetName="Rule" Property="Background" Value="{DynamicResource Viewer.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Rule" Property="Width" Value="3"/>
                                <Setter TargetName="Rule" Property="Background" Value="{DynamicResource Viewer.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EvidenceMutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Viewer.Muted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Viewer.SelectionText}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EvidenceList" TargetType="ListBox">
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="{DynamicResource Viewer.Canvas}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Viewer.Text}"/>
                        <Setter Property="FocusVisualStyle" Value="{StaticResource Desk.KeyboardOutline}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="EvidenceListRowBorder" Background="{TemplateBinding Background}" Padding="3,2">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="{DynamicResource Viewer.RowAlternate}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Viewer.Selection}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Viewer.SelectionText}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource Viewer.Hover}"/>
                            </MultiTrigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EvidenceGrid" TargetType="DataGrid">
            <Setter Property="AlternationCount" Value="2"/>
            <EventSetter Event="Loaded" Handler="EnableEvidenceSorting"/>
            <Setter Property="Background" Value="{DynamicResource Viewer.Canvas}"/>
            <Setter Property="Foreground" Value="{DynamicResource Viewer.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Viewer.Rule}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Viewer.RowRule}"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="23"/>
            <Setter Property="ColumnHeaderHeight" Value="26"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource Desk.LogHeader}"/>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="{DynamicResource Viewer.Text}"/>
                        <Setter Property="Background" Value="{DynamicResource Viewer.Canvas}"/>
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="{DynamicResource Viewer.RowAlternate}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource Viewer.Hover}"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Viewer.Selection}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Viewer.SelectionText}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{DynamicResource Viewer.Text}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Viewer.Selection}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Viewer.Selection}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Viewer.SelectionText}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Viewer.Accent}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
      </ResourceDictionary>
    </Application.Resources>
</Application>
