<Window x:Class="MailViewer.App.ImageSourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="540" MinWidth="550" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        FontFamily="Segoe UI, Malgun Gothic" Closing="OnClosing"
        Background="{DynamicResource Viewer.Canvas}" Foreground="{DynamicResource Viewer.Text}">
    <Border Padding="16" Background="{DynamicResource Viewer.Canvas}">
      <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="Heading" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock x:Name="ImageName" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label x:Name="VolumeLabel" Target="{Binding ElementName=Volumes}" VerticalAlignment="Center" Padding="0,0,10,0"/>
            <ComboBox x:Name="Volumes" Grid.Column="1" DisplayMemberPath="Label" Style="{StaticResource ViewerComboBox}"
                      Height="{StaticResource FormInputHeight}" MinHeight="0"
                      HorizontalAlignment="Stretch" SelectionChanged="OnVolumeChanged"
                      AutomationProperties.AutomationId="ImageVolumeSelector"/>
            <Button x:Name="WholeVolumeButton" Grid.Column="2" Style="{StaticResource Action}" Tag="&#xE721;"
                    Click="SearchWholeVolume" Height="{StaticResource FormInputHeight}" Margin="8,0,0,0"
                    AutomationProperties.AutomationId="SearchImageVolume"/>
        </Grid>
        <DataGrid x:Name="Candidates" Grid.Row="2" Style="{StaticResource EvidenceGrid}" RowHeight="26"
                  AutomationProperties.AutomationId="ImageMailCandidates">
            <DataGrid.Columns>
                <DataGridTemplateColumn x:Name="CheckColumn" Width="62" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Checked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanAnalyze}"
                                      ToolTip="{Binding LimitReason}" ToolTipService.ShowOnDisabled="True"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      AutomationProperties.Name="{Binding Path}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="NameColumn" Binding="{Binding Name}" Width="2*" MinWidth="110" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="PathColumn" Binding="{Binding Path}" Width="4*" MinWidth="110" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Path}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="SizeColumn" Binding="{Binding Length, StringFormat=N0}" Width="112" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="Warnings" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <ProgressBar x:Name="Progress" Height="3" Margin="0,5,0,0" Visibility="Collapsed" IsIndeterminate="True"/>
        </StackPanel>
        <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CloseButton" Style="{StaticResource Action}" Click="CloseOrCancel"/>
            <Button x:Name="ExtractButton" Style="{StaticResource PrimaryAction}" Click="ExtractSelected"
                    IsEnabled="False" AutomationProperties.AutomationId="ExtractImageMail"/>
        </WrapPanel>
      </Grid>
    </Border>
</Window>
