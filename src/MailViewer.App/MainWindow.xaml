<Window x:Class="MailViewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MailViewer.App" xmlns:desk="clr-namespace:JournalDesk"
        Title="Mail Evidence" Language="ko-KR" Icon="Assets/MailViewer.ico" Width="1190" Height="795" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource Viewer.Canvas}" Foreground="{DynamicResource Viewer.Text}"
        FontFamily="Segoe UI, Malgun Gothic" PreviewKeyDown="OnWindowKeyDown"
        Closing="OnClosing" SizeChanged="OnMailboxViewportSizeChanged">
    <Window.Resources>
        <Style x:Key="FilterDisclosure" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          FocusVisualStyle="{StaticResource Desk.KeyboardOutline}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="DisclosureSurface" Background="{DynamicResource Viewer.Panel}"
                                                BorderBrush="{DynamicResource Viewer.Rule}" BorderThickness="1" CornerRadius="4"
                                                MinHeight="{StaticResource FormInputHeight}" Padding="8,3">
                                            <DockPanel LastChildFill="True">
                                                <Path x:Name="DisclosureArrow" DockPanel.Dock="Right" Data="{StaticResource Lucide.ChevronDown}"
                                                      Width="10" Height="7" Margin="6,0,2,0" Stretch="Uniform" VerticalAlignment="Center"
                                                      Stroke="{DynamicResource Viewer.Muted}" StrokeThickness="1.35" RenderTransformOrigin="0.5,0.5"/>
                                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"
                                                                  TextElement.Foreground="{DynamicResource Viewer.Text}"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="DisclosureArrow" Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="DisclosureSurface" Property="Background" Value="{DynamicResource Viewer.Hover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="Details" Visibility="Collapsed" Margin="0,3,0,0"
                                    BorderBrush="{DynamicResource Viewer.Rule}" BorderThickness="1" CornerRadius="4"
                                    Background="{DynamicResource Viewer.Panel}">
                                <ContentPresenter/>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Details" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchableOptions" TargetType="local:SearchableComboBox" BasedOn="{StaticResource ViewerComboBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:SearchableComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" IsTabStop="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Outline" Background="{DynamicResource Viewer.Panel}"
                                                BorderBrush="{DynamicResource Viewer.Rule}" BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Path Data="{StaticResource Lucide.ChevronDown}" Width="10" Height="7" Stretch="Uniform"
                                                      HorizontalAlignment="Right" Margin="0,0,10,0"
                                                      Stroke="{DynamicResource Viewer.Muted}" StrokeThickness="1.35"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Outline" Property="Background" Value="{DynamicResource Viewer.Hover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="8,0,28,0"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        BorderBrush="{DynamicResource Viewer.Rule}" BorderThickness="1" CornerRadius="4"
                                        Background="{DynamicResource Viewer.Panel}" Padding="4">
                                    <DockPanel KeyboardNavigation.DirectionalNavigation="Contained">
                                        <DockPanel x:Name="SearchPanel" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,4">
                                            <Path DockPanel.Dock="Left" Data="{StaticResource Lucide.Search}" Stretch="Uniform" Width="13" Height="13"
                                                  Stroke="{DynamicResource Viewer.Muted}" StrokeThickness="1.25" Margin="6,0,7,0"/>
                                            <TextBox x:Name="PART_Search" AutomationProperties.AutomationId="DropdownSearch"/>
                                        </DockPanel>
                                        <TextBlock x:Name="EmptyOptions" DockPanel.Dock="Top" Visibility="Collapsed"
                                                   Foreground="{DynamicResource Viewer.Muted}" Margin="8,7"/>
                                        <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MailBookmarkAction" TargetType="Button" BasedOn="{StaticResource IconAction}">
            <Setter Property="Tag" Value="{StaticResource Lucide.Bookmark}"/>
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Bookmarked}" Value="True">
                    <Setter Property="Tag" Value="{StaticResource Lucide.BookmarkCheck}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Viewer.Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MailPinAction" TargetType="Button" BasedOn="{StaticResource IconAction}">
            <Setter Property="Tag" Value="{StaticResource Lucide.Pin}"/>
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Pinned}" Value="True">
                    <Setter Property="local:MainWindow.FillCommandIcon" Value="True"/>
                    <Setter Property="Foreground" Value="{DynamicResource Viewer.Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ConversationRowTemplate">
            <StackPanel Margin="5,4">
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Info}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="FindingCellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <DataTemplate x:Key="EvidenceFieldTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="EvidenceLabel"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Viewer.Muted}"
                           VerticalAlignment="Top" Margin="0,4,12,2"/>
                <desk:CopyText Grid.Column="1" Text="{Binding Value, Mode=OneWay}" AutomationProperties.Name="{Binding Label}"
                               VerticalScrollBarVisibility="Disabled" Margin="0" Padding="0,3,2,3">
                    <desk:CopyText.Style>
                        <Style TargetType="desk:CopyText" BasedOn="{StaticResource CopyField}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDigest}" Value="True">
                                    <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </desk:CopyText.Style>
                </desk:CopyText>
            </Grid>
        </DataTemplate>
        <local:AttachmentIconConverter x:Key="AttachmentIcon"/>
        <local:MailReaderTextConverter x:Key="MailReaderText"/>
        <Style x:Key="FolderPaneToggleStyle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Desk.KeyboardOutline}"/>
            <Setter Property="Foreground" Value="{DynamicResource Viewer.Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Face" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentControl x:Name="Glyph" Content="{TemplateBinding Tag}" Template="{StaticResource CommandIcon}"
                                                Foreground="{TemplateBinding Foreground}" IsTabStop="False" Focusable="False"
                                                VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ContentPresenter x:Name="Label" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="ContentStringFormat" Value="GlyphOnly">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/><Setter TargetName="Glyph" Property="Margin" Value="0"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="local:MainWindow.UseToggleHighlight" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Viewer.Selection}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Viewer.SelectionText}"/>
                            </MultiTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Viewer.Accent}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="local:MainWindow.UseToggleHighlight" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Face" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Viewer.Hover}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Viewer.Disabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Background="{DynamicResource Viewer.Canvas}">
        <Border x:Name="MainMenuDivider" DockPanel.Dock="Top" Background="{DynamicResource Desk.Panel}"
                BorderBrush="{DynamicResource Desk.Rule}" BorderThickness="0,0,0,1">
        <Menu x:Name="MainMenu" IsMainMenu="True" Background="Transparent" Padding="4,0"
              VerticalContentAlignment="Center" AutomationProperties.Name="주 메뉴">
            <Menu.Resources>
                <ResourceDictionary Source="CompactMenu.xaml"/>
            </Menu.Resources>
            <MenuItem x:Name="FileMenu" Header="파일(_F)">
                <MenuItem Header="자료 추가…" Click="OpenIntake"/>
                <MenuItem Header="파일 열기" InputGestureText="Ctrl+O" Click="ChooseFiles"/>
                <MenuItem Header="폴더 열기" InputGestureText="Ctrl+Shift+O" Click="ChooseFolder"/>
                <Separator/>
                <MenuItem Header="최근 내보내기 확인" Click="ReviewRecentExports" AutomationProperties.AutomationId="RecentExportsMenuItem"/>
                <MenuItem Header="닫기" InputGestureText="Alt+F4" Click="Exit"/>
            </MenuItem>
            <MenuItem Header="편집(_E)">
                <MenuItem Header="복사" InputGestureText="Ctrl+C" Command="Copy"/>
                <MenuItem Header="검색" InputGestureText="Ctrl+F" Click="FocusSearch"/>
                <MenuItem x:Name="FindRelatedMailMenuItem" Click="FindRelatedMail" IsEnabled="False"
                          AutomationProperties.AutomationId="FindRelatedMailMenuItem"/>
            </MenuItem>
            <MenuItem Header="보기(_V)">
                <MenuItem x:Name="ShowSettingsMenuItem" Header="설정" InputGestureText="Ctrl+,"
                          IsChecked="{Binding IsSelected, ElementName=SourcesTab, Mode=OneWay}" Click="OpenIntake"/>
                <Separator/>
                <MenuItem Header="밝은 테마" Click="SwitchTheme" Tag="light" AutomationProperties.AutomationId="LightThemeMenuItem"/>
                <MenuItem Header="어두운 테마" Click="SwitchTheme" Tag="dark" AutomationProperties.AutomationId="DarkThemeMenuItem"/>
                <Separator/>
                <MenuItem Header="표시 언어">
                    <MenuItem Header="한국어" Tag="ko" Click="SwitchLanguage" AutomationProperties.AutomationId="KoreanLanguageMenuItem"/>
                    <MenuItem Header="English" Tag="en" Click="SwitchLanguage" AutomationProperties.AutomationId="EnglishLanguageMenuItem"/>
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="ExportMenu" Header="내보내기(_X)" Visibility="Collapsed" AutomationProperties.AutomationId="ExportMenu">
                <MenuItem x:Name="ExportSelectedButton" Header="현재 메일" Click="PrepareSelectedExport"/>
                <MenuItem x:Name="ExportAttachmentButton" Header="첨부파일 근거 묶음" Click="PrepareAttachmentExport"/>
                <Separator/>
                <MenuItem x:Name="ExportSearchButton" Header="검색 결과" Click="PrepareSearchExport"/>
            </MenuItem>
        </Menu>
        </Border>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Desk.StatusBar}" MinHeight="27">
            <DockPanel>
                <Button x:Name="CancelWorkButton" AutomationProperties.AutomationId="CancelWorkButton"
                        DockPanel.Dock="Right" Content="&#xE71A;" Click="CancelWork" IsEnabled="False"
                        ToolTip="작업 취소" AutomationProperties.Name="작업 취소">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Desk.IconButton}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <ProgressBar x:Name="ProgressIndicator" DockPanel.Dock="Right" Width="100" Height="7"
                             Margin="7,0" Visibility="Collapsed"/>
                <TextBlock x:Name="WorkStatus" AutomationProperties.AutomationId="WorkStatus"
                           AutomationProperties.LiveSetting="Polite" Style="{StaticResource Desk.StatusText}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </DockPanel>
        </Border>
        <Grid>
            <TabControl x:Name="WorkspaceTabs" Style="{StaticResource WorkspaceTabs}" SelectionChanged="OnMailboxTabChanged">
                <TabItem x:Name="InvestigationTab" AutomationProperties.AutomationId="InvestigationTab" Header="전체" IsEnabled="False" Visibility="Collapsed">
                    <Grid x:Name="MailboxWorkspace" Loaded="OnMailboxWorkspaceLoaded" PreviewKeyDown="OnMailboxWorkspaceKeyDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="MailboxFolderColumn" Width="0"/>
                            <ColumnDefinition x:Name="MailboxFolderDividerColumn" Width="0"/>
                            <ColumnDefinition x:Name="MailboxResultsColumn" Width="375" MinWidth="290"/>
                            <ColumnDefinition x:Name="MailboxSplitterColumn" Width="5"/>
                            <ColumnDefinition x:Name="MailboxReaderColumn" Width="*" MinWidth="430"/>
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="MailboxFolderSurface">
                        <Border x:Name="PstFolderPane" Visibility="Collapsed" Background="{DynamicResource Viewer.Panel}">
                            <DockPanel>
                                <Grid x:Name="AllMailboxRail" DockPanel.Dock="Top" Height="{StaticResource WorkspaceRailHeight}" Margin="2,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="PstFoldersToggle" local:MainWindow.UseToggleHighlight="False" IsChecked="True"
                                                  Tag="{StaticResource Lucide.Panel}" ContentStringFormat="GlyphOnly"
                                                  ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}"
                                                  AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                                  AutomationProperties.AutomationId="PstFoldersToggle"
                                                  FocusVisualStyle="{StaticResource Desk.KeyboardOutline}" Click="OnMailboxPaneToggled"
                                                  Width="30" Height="27" HorizontalAlignment="Left" ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                                                  Style="{StaticResource FolderPaneToggleStyle}"/>
                                    <ToggleButton x:Name="AllMailScopeButton" Grid.Column="1" Content="전체 메일"
                                                  AutomationProperties.AutomationId="AllMailScopeButton" Click="SelectAllMailboxSources"
                                                  AutomationProperties.Name="{Binding Content,RelativeSource={RelativeSource Self}}"
                                                  VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" FocusVisualStyle="{StaticResource Desk.KeyboardOutline}">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Foreground" Value="{DynamicResource Viewer.Text}"/>
                                            </Style>
                                        </ToggleButton.Style>
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Background="Transparent">
                                                    <Border x:Name="Face" CornerRadius="3" Margin="0,1"/>
                                                    <Border x:Name="Hover" CornerRadius="3" Margin="0,1" Background="{DynamicResource Viewer.Hover}" Opacity="0"/>
                                                    <DockPanel Margin="5,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock DockPanel.Dock="Right" Margin="5,0,0,0" FontSize="11"
                                                                   Foreground="{DynamicResource Viewer.Muted}"
                                                                   Text="{Binding (local:MainWindow.MailboxCount),RelativeSource={RelativeSource TemplatedParent}}"/>
                                                        <ContentControl DockPanel.Dock="Left" Margin="0,0,5,0" Content="{StaticResource Lucide.Inbox}"
                                                                        Template="{StaticResource CommandIcon}" Foreground="{TemplateBinding Foreground}" Focusable="False"/>
                                                        <TextBlock Text="{TemplateBinding Content}" TextTrimming="CharacterEllipsis" Foreground="{TemplateBinding Foreground}"/>
                                                    </DockPanel>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Hover" Property="local:InteractionFeedback.HoverVisible" Value="True"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Face" Property="Background" Value="{DynamicResource Viewer.Hover}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Face" Property="Background" Value="{DynamicResource Viewer.Selection}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Viewer.SelectionText}"/>
                                                        <Setter TargetName="Hover" Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource Viewer.Disabled}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                                <TreeView x:Name="PstFolderTree" AutomationProperties.AutomationId="PstFolderTree"
                                          AutomationProperties.Name="폴더"
                                          Background="Transparent" Foreground="{DynamicResource Viewer.Text}"
                                          BorderThickness="0" Padding="2,0,2,4" HorizontalContentAlignment="Stretch"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          SelectedItemChanged="OnPstFolderSelected">
                                    <TreeView.Resources>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="FocusVisualStyle" Value="{StaticResource Desk.KeyboardOutline}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Viewer.Text}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TreeViewItem">
                                                        <Grid>
                                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                            <Grid x:Name="FolderHeaderRow" Background="Transparent">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <Border x:Name="Row" Grid.ColumnSpan="2" MinHeight="27" CornerRadius="3"
                                                                        BorderThickness="1" BorderBrush="Transparent" IsHitTestVisible="False"/>
                                                                <Border x:Name="FolderHoverLayer" Grid.ColumnSpan="2" CornerRadius="3" IsHitTestVisible="False"
                                                                        Background="{DynamicResource Viewer.Hover}" Opacity="0"/>
                                                                <ToggleButton x:Name="FolderArrow" Grid.Column="0" Focusable="False" IsTabStop="False"
                                                                              Foreground="{DynamicResource Viewer.Muted}"
                                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border Background="Transparent">
                                                                                <ContentControl x:Name="Chevron" Content="{StaticResource Lucide.ChevronRight}"
                                                                                                Template="{StaticResource CommandIcon}" Foreground="{TemplateBinding Foreground}"
                                                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                IsHitTestVisible="False" Focusable="False" RenderTransformOrigin="0.5,0.5"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsChecked" Value="True">
                                                                                    <Setter TargetName="Chevron" Property="local:InteractionFeedback.ChevronOpen" Value="True"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                </ToggleButton>
                                                                <DockPanel x:Name="FolderLabel" Grid.Column="1" Margin="1,1,6,1" LastChildFill="True">
                                                                    <TextBlock x:Name="FolderCount" DockPanel.Dock="Right" Margin="6,0,0,0"
                                                                               FontSize="11" Foreground="{DynamicResource Viewer.Muted}" VerticalAlignment="Center"
                                                                               IsHitTestVisible="False"
                                                                               Text="{Binding (local:MainWindow.MailboxCount), RelativeSource={RelativeSource TemplatedParent}}"/>
                                                                    <ContentPresenter x:Name="PART_Header" ContentSource="Header" VerticalAlignment="Center"
                                                                                      HorizontalAlignment="Stretch" RecognizesAccessKey="True"/>
                                                                </DockPanel>
                                                            </Grid>
                                                            <ItemsPresenter x:Name="Children" Grid.Row="1" Margin="15,0,0,0"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsExpanded" Value="False">
                                                                <Setter TargetName="Children" Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                            <Trigger Property="HasItems" Value="False">
                                                                <Setter TargetName="FolderArrow" Property="Visibility" Value="Hidden"/>
                                                            </Trigger>
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition SourceName="FolderHeaderRow" Property="IsMouseOver" Value="True"/>
                                                                    <Condition Property="IsSelected" Value="False"/>
                                                                    <Condition Property="IsEnabled" Value="True"/>
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="FolderHoverLayer" Property="local:InteractionFeedback.HoverVisible" Value="True"/>
                                                            </MultiTrigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Viewer.Selection}"/>
                                                                <Setter TargetName="FolderArrow" Property="Foreground" Value="{DynamicResource Viewer.SelectionText}"/>
                                                                <Setter TargetName="FolderHoverLayer" Property="Visibility" Value="Hidden"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TreeView.Resources>
                                </TreeView>
                            </DockPanel>
                        </Border>
                        </Grid>
                        <GridSplitter x:Name="MailboxFolderSplitter" Grid.Column="1" Visibility="Collapsed"
                                      Style="{StaticResource VerticalPaneSplitter}" ShowsPreview="True" KeyboardIncrement="12"
                                      DragCompleted="OnMailboxFolderDragCompleted" KeyUp="OnMailboxFolderSplitterKeyUp"
                                      ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                                      AutomationProperties.AutomationId="MailboxFolderSplitter"
                                      ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(AutomationProperties.Name)}"/>
                        <Grid x:Name="MailboxResultsPane" Grid.Column="2" Background="{DynamicResource Viewer.Panel}">
                         <DockPanel>
                            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Viewer.Rule}" BorderThickness="0,0,0,1">
                        <StackPanel x:Name="SearchPane">
                            <Border x:Name="MailboxSearchRail" Style="{StaticResource PaneHeading}">
                                <DockPanel VerticalAlignment="Center">
                                <Button x:Name="InvestigationSearchBack" DockPanel.Dock="Right" Visibility="Collapsed"
                                        AutomationProperties.AutomationId="InvestigationSearchBack" Click="ReturnFromInvestigationSearch"
                                        Style="{StaticResource QuietAction}"/>
                                <ToggleButton x:Name="AddressFiltersToggle" DockPanel.Dock="Right" Content="필터"
                                              Tag="{StaticResource Lucide.Filter}" ContentStringFormat="GlyphOnly"
                                              ToolTip="{Binding Content,RelativeSource={RelativeSource Self}}"
                                              AutomationProperties.Name="{Binding Content,RelativeSource={RelativeSource Self}}"
                                              AutomationProperties.AutomationId="AddressFiltersToggle" Click="OpenSearchFilters"
                                              Width="30" Height="27" Margin="4,0,0,0"
                                              Style="{StaticResource FolderPaneToggleStyle}"/>
