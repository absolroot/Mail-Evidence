                                                <DockPanel x:Name="InvestigationEvidenceBody">
                                                    <DataGrid x:Name="InvestigationGrid" AutomationProperties.AutomationId="InvestigationGrid"
                                                              Style="{StaticResource EvidenceGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                                                              CanUserSortColumns="False" CanUserReorderColumns="False"
                                                              RowHeight="NaN" MinRowHeight="27"
                                                              PreviewKeyDown="OnInvestigationEvidenceKeyDown">
                                                        <DataGrid.Columns>
                                                            <DataGridTemplateColumn Width="2*">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <desk:CopyText Text="{Binding Field, Mode=OneWay}" Style="{StaticResource CopyField}"
                                                                                       Padding="4,1" MinHeight="0"
                                                                                       ContextMenu="{Binding ContextMenu, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                            <DataGridTemplateColumn Width="5*">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <desk:CopyText Text="{Binding Observation.Value, Mode=OneWay}" Style="{StaticResource CopyField}"
                                                                                       Padding="4,1" MinHeight="0" MaxHeight="85" ToolTip="{Binding Tooltip}"
                                                                                       ContextMenu="{Binding ContextMenu, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </DockPanel>
                                            </Grid>
                                            <Button x:Name="OpenFindingSourceButton" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                    Style="{StaticResource Action}" Tag="{StaticResource Lucide.Code}" Visibility="Collapsed"
                                                    Click="OpenFindingDetail" AutomationProperties.AutomationId="OpenFindingSourceButton"/>
                                            <Expander x:Name="FindingCriteria" Margin="0,6,0,0">
                                                <TextBlock x:Name="FindingDescription" TextWrapping="Wrap" Margin="3,4,0,4"/>
                                            </Expander>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem x:Name="AnomalyMailboxTab" Header="이상 징후 (0건)" IsEnabled="False" Visibility="Collapsed"
                         AutomationProperties.AutomationId="AnomalyMailboxTab"/>
                <TabItem x:Name="BookmarksMailboxTab" Header="북마크 (0건)" IsEnabled="False" Visibility="Collapsed"
                         AutomationProperties.AutomationId="BookmarksMailboxTab"/>
                <TabItem x:Name="SourcesTab" DockPanel.Dock="Right" MinWidth="84" Header="설정" IsSelected="True"
                         ToolTip="설정 (Ctrl+,)" AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}"
                         AutomationProperties.AutomationId="SourcesTab">
                    <TabItem.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </TabItem.HeaderTemplate>
                    <Grid x:Name="IntakePane" Margin="24,16" AllowDrop="True"
                          DragOver="OnIntakeDragOver" Drop="OnIntakeDrop">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer x:Name="IntakeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="분석할 자료" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <StackPanel x:Name="IntakeButtons">
                                        <Border Padding="10,7" Background="{DynamicResource Viewer.Panel}" BorderBrush="{DynamicResource Viewer.Rule}"
                                                BorderThickness="1" CornerRadius="4">
                                            <StackPanel>
                                                <WrapPanel>
                                                    <Button x:Name="OpenFilesButton" Content="파일 선택…" Tag="&#xE8E5;" Click="ChooseFiles"
                                                            Style="{StaticResource Action}" AutomationProperties.AutomationId="OpenFilesButton" Margin="0,0,6,0"/>
                                                    <Button Content="폴더 선택…" Tag="&#xE8B7;" Click="ChooseFolder" Style="{StaticResource Action}"
                                                            AutomationProperties.AutomationId="OpenFolderButton" Margin="0,0,6,0"/>
                                                    <Button x:Name="OpenDiskImageButton" Content="디스크 이미지…" Tag="&#xE958;" Click="ChooseDiskImage"
                                                            Style="{StaticResource Action}" AutomationProperties.AutomationId="OpenDiskImageButton" Margin="0,0,6,0"/>
                                                </WrapPanel>
                                                <TextBlock Text="메일 파일, 폴더 또는 디스크 이미지를 끌어 놓을 수 있습니다."
                                                           TextWrapping="Wrap" Foreground="{DynamicResource Viewer.Muted}" FontSize="12" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="FindSourcesButton" Content="이 PC에서 메일 파일 찾기…" Tag="&#xE721;" Click="OpenFindSources"
                                                Style="{StaticResource QuietAction}" AutomationProperties.AutomationId="FindSourcesButton"
                                                HorizontalAlignment="Left" Margin="10,5,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <DockPanel Margin="0,0,0,5"
                                           Visibility="{Binding HasItems, ElementName=CandidateGrid, Converter={StaticResource EvidenceVisibility}}">
                                    <WrapPanel DockPanel.Dock="Right">
                                        <Button x:Name="RemoveCandidateButton" Content="선택 항목 제거" Click="RemoveCandidate"
                                                Style="{StaticResource QuietAction}" AutomationProperties.AutomationId="RemoveCandidateButton"/>
                                        <Button x:Name="ClearPendingButton" Content="목록 비우기" Click="ClearPendingFiles"
                                                Style="{StaticResource QuietAction}" AutomationProperties.AutomationId="ClearPendingButton"/>
                                    </WrapPanel>
                                    <TextBlock Text="선택한 자료" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </DockPanel>
                                <DataGrid x:Name="CandidateGrid" Style="{StaticResource EvidenceGrid}" MaxHeight="255"
                                          Visibility="{Binding HasItems, RelativeSource={RelativeSource Self}, Converter={StaticResource EvidenceVisibility}}"
                                          SelectionChanged="OnCandidateSelectionChanged"
                                          AutomationProperties.AutomationId="CandidateGrid" AutomationProperties.Name="분석할 파일 목록">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="포함" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding Included, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEnabled="{Binding Exists}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              AutomationProperties.Name="{Binding Path}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="파일명" Binding="{Binding Name}" Width="1.6*" MinWidth="108" IsReadOnly="True" ElementStyle="{StaticResource EvidenceCellText}"/>
                                        <DataGridTextColumn Header="유형" Binding="{Binding Kind}" Width="102" IsReadOnly="True" ElementStyle="{StaticResource EvidenceCellText}"/>
                                        <DataGridTextColumn Header="경로" Binding="{Binding Path}" Width="3*" MinWidth="100" IsReadOnly="True" ElementStyle="{StaticResource EvidenceCellText}"/>
                                        <DataGridTextColumn Header="선택 방식" Binding="{Binding Origin}" Width="105" IsReadOnly="True" ElementStyle="{StaticResource EvidenceCellText}"/>
                                        <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="112" IsReadOnly="True" ElementStyle="{StaticResource EvidenceCellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Expander x:Name="SourcesReportPanel" Margin="0,10,0,0"
                                          Header="분석 결과와 해시" Visibility="Collapsed">
                                    <TextBox x:Name="SourcesReportBox" Style="{StaticResource Copyable}" MaxHeight="130"
                                             AutomationProperties.AutomationId="SourcesReportBox" AutomationProperties.Name="자료 경로, 분석 결과 및 SHA-256"/>
                                </Expander>
                                <StackPanel x:Name="DisplaySettingsSection" Margin="0,14,0,0">
                                    <TextBlock Text="화면" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Border Background="{DynamicResource Viewer.Panel}" BorderBrush="{DynamicResource Viewer.Rule}"
                                            BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <Border Padding="12,4" BorderBrush="{DynamicResource Viewer.Rule}" BorderThickness="0,0,0,1">
                                                <DockPanel>
                                                    <ComboBox x:Name="SettingsThemeBox" Style="{StaticResource ViewerComboBox}" DockPanel.Dock="Right" Width="165" AutomationProperties.Name="테마"
                                                              SelectionChanged="ChangeSettingsTheme">
                                                        <ComboBoxItem Content="밝은 테마"/>
                                                        <ComboBoxItem Content="어두운 테마"/>
                                                    </ComboBox>
                                                    <TextBlock Text="테마" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                            <DockPanel Margin="12,4">
                                                <ComboBox x:Name="SettingsLanguageBox" Style="{StaticResource ViewerComboBox}" DockPanel.Dock="Right" Width="165" AutomationProperties.Name="표시 언어"
                                                          SelectionChanged="ChangeSettingsLanguage">
                                                    <ComboBoxItem Content="한국어"/>
                                                    <ComboBoxItem Content="English"/>
                                                </ComboBox>
                                                <TextBlock Text="표시 언어" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="1" Margin="0,12,0,0" Padding="0,10,0,0"
                                BorderBrush="{DynamicResource Viewer.Rule}" BorderThickness="0,1,0,0">
                            <WrapPanel HorizontalAlignment="Right">
                                <Button x:Name="CancelIntakeButton" Content="돌아가기" Style="{StaticResource Action}" Click="CancelIntake"
                                        Visibility="Collapsed" AutomationProperties.AutomationId="CancelIntakeButton"/>
                                <Button x:Name="AnalyzeButton" Content="분석 시작" IsEnabled="False"
                                        Style="{StaticResource PrimaryAction}" Click="Analyze" AutomationProperties.AutomationId="AnalyzeButton"/>
                            </WrapPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
            <Border x:Name="ExportPanel" Panel.ZIndex="4" Visibility="Collapsed"
                    Background="{DynamicResource Viewer.Canvas}" Padding="16"
                    AutomationProperties.AutomationId="ExportPanel">
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource Viewer.Rule}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,9">
                        <TextBlock x:Name="ExportTitle" Text="내보내기" FontSize="18" FontWeight="SemiBold"/>
                    </Border>
                    <Grid x:Name="ExportOptionsPanel" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ExportLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="형식" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource Viewer.Muted}"/>
                        <local:SearchableComboBox x:Name="ExportKindBox" Style="{StaticResource SearchableOptions}" Grid.Column="1" AutomationProperties.AutomationId="ExportKindBox"
                                  AutomationProperties.Name="내보내기 형식" MaxWidth="355" HorizontalAlignment="Left"
                                  MinWidth="227" Height="{StaticResource FormInputHeight}" MinHeight="0"/>
                    </Grid>
                    <Grid x:Name="DestinationPanel" Grid.Row="2" Margin="0,9,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ExportLabel"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="저장 폴더" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource Viewer.Muted}"/>
                        <TextBox x:Name="DestinationBox" Grid.Column="1" Padding="7,3" Height="{StaticResource FormInputHeight}" MinHeight="0" AutomationProperties.AutomationId="DestinationBox"
                                 AutomationProperties.Name="저장할 기존 폴더"/>
                        <Button Grid.Column="2" Content="찾아보기…" Tag="&#xE8B7;" Click="BrowseExportDestination"
                                Style="{StaticResource Action}" Margin="5,0,0,0"/>
                    </Grid>
                    <DockPanel Grid.Row="3" VerticalAlignment="Top">
                        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,8,0,0">
                            <Button x:Name="ReturnToSearchButton" DockPanel.Dock="Left" Content="검색 결과로 돌아가기"
                                    Tag="{StaticResource Lucide.Back}" Click="ReturnToSearch" Style="{StaticResource QuietAction}"
                                    AutomationProperties.AutomationId="ReturnToSearchButton"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="VerifyExportButton" Content="결과 다시 검증" Tag="&#xE72C;" Click="VerifyExport" Style="{StaticResource QuietAction}"
                                        AutomationProperties.AutomationId="VerifyExportButton" Visibility="Collapsed"/>
                                <Button x:Name="SaveExportButton" Content="저장" Tag="&#xE74E;" Click="SaveExport" Style="{StaticResource PrimaryAction}"
                                        AutomationProperties.AutomationId="SaveExportButton"/>
                            </StackPanel>
                        </DockPanel>
                        <Border MaxHeight="424" MinHeight="104"
                                Background="{DynamicResource Viewer.Panel}" BorderBrush="{DynamicResource Viewer.Rule}" BorderThickness="1">
                            <desk:CopyText x:Name="ExportReportBox" Style="{StaticResource CopyField}" Padding="10,8"
                                     AutomationProperties.AutomationId="ExportReportBox" AutomationProperties.Name="내보내기 대상 및 검증 결과"/>
                        </Border>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
