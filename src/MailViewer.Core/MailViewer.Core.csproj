<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.6.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MailFormatWorker Condition="'$(MailFormatWorker)' == ''">$(MSBuildProjectDirectory)/../../engine/target/release/mailviewer-engine.exe</MailFormatWorker>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="public_suffix_list.dat" />
    <EmbeddedResource Include="$(MailFormatWorker)" LogicalName="MailViewer.Core.FormatWorker"
                      Condition="Exists('$(MailFormatWorker)')" />
    <PackageReference Include="MimeKit.Core" Version="5.0.0" />
    <PackageReference Include="OpenMcdf" Version="3.4.0" />
  </ItemGroup>
</Project>
